{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GateKeeper: Upload Firmware Bundle",
      "type": "process",
      "command": "pio",
      "args": [
        "run",
        "-t",
        "upload"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "GateKeeper: Build Firmware Bundle",
      "type": "process",
      "command": "pio",
      "args": [
        "run"
      ],
      "group": "build",
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "GateKeeper: Clean Firmware Bundle",
      "type": "process",
      "command": "pio",
      "args": [
        "run",
        "-t",
        "clean"
      ],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "GateKeeper: Refresh IntelliSense",
      "type": "process",
      "command": "python3",
      "args": [
        "platformio_tools/update_compile_commands.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
